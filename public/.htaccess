# ==============================================================================
# Warung Rimbun - Apache / LiteSpeed Web Server Configuration (.htaccess)
# ==============================================================================

# 1. Matikan Directory Indexing (Cegah pengunjung melihat isi folder)
Options -Indexes

# 2. Blokir Akses Langsung ke File Konfigurasi Sensitif, Database, & Source Code
<FilesMatch "^(\.env|\.git|\.dockerignore|docker-compose\.yml|Dockerfile|package\.json|package-lock\.json|schema\.sql|server\.ts|tsconfig\.json|metadata\.json|db\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir Akses ke Folder data/ dan .git/
RedirectMatch 403 ^/data(/.*)?$
RedirectMatch 403 ^/\.git(/.*)?$

# 4. Header Keamanan Modern (HTTP Security Headers)
<IfModule mod_headers.c>
    # Cegah MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Proteksi Clickjacking (Izinkan iframe hanya dari domain yang sama / preview)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Proteksi XSS Filter Browser
    Header set X-XSS-Protection "1; mode=block"
    
    # Kebijakan Referrer yang Aman
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Cegah Flash & PDF mengeksekusi script tak diinginkan
    Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# 5. Single Page Application (SPA) Routing & Reverse Proxy
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jika diarahkan ke backend Express / Node API di port 3000 atau 3080
    # RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

    # Redirect semua request non-file dan non-folder ke index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# 6. Kompresi Gzip untuk Kecepatan Loading Maksimal
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 7. Pengaturan Cache Browser untuk Aset Gambar & Font
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
